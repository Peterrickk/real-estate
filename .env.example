# BCH network: mainnet | testnet | chipnet
VITE_BCH_NETWORK=chipnet

# Google Maps — Maps JavaScript API + Places API (see README)

# Optional: future API keys (e.g. custom Electrum server, indexer, WalletConnect)
# VITE_ELECTRUM_URL=
# VITE_WALLETCONNECT_PROJECT_ID=

# PhilSA / CopPhil (production Sentinel-1 flood mapping — requires account + backend proxy)
# VITE_PHILSA_COP_PHIL_CATALOGUE=https://catalogue.infra.copphil.philsa.gov.ph/odata/v1
# VITE_PHILSA_COP_PHIL_S3=https://eodata.infra.copphil.philsa.gov.ph
